{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deck headmatter",
  "description": "The first frontmatter block of decks/<slug>/slides.md. Mirrors scripts/lib/decks.ts.",
  "type": "object",
  "required": ["theme", "title", "routerMode", "card"],
  "properties": {
    "theme": { "const": "terminal" },
    "title": { "type": "string", "minLength": 1 },
    "info": { "type": "string" },
    "routerMode": { "const": "hash" },
    "themeConfig": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "object",
          "properties": { "user": { "type": "string" }, "host": { "type": "string" }, "path": { "type": "string" } }
        }
      }
    },
    "card": {
      "type": "object",
      "required": ["date", "type"],
      "properties": {
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "type": { "enum": ["talk", "case-study", "note", "open-source"] },
        "event": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "draft": { "type": "boolean" },
        "links": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
