---
import { getCollection } from 'astro:content';
import DeckWall from '../components/DeckWall.astro';
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

// Drafts show up while developing and are left out of the published site.
const decks = (await getCollection('decks', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base>
  <section class="intro">
    <h1>{site.headline}</h1>
    <p>{site.intro}</p>
  </section>

  <section aria-label="Decks">
    <DeckWall decks={decks} />
  </section>
</Base>

<style>
  .intro {
    padding-block: clamp(2.5rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  h1 {
    max-width: 17ch;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 4.75rem);
    font-weight: var(--weight-strong);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .intro p {
    max-width: 56ch;
    margin-top: 1.5rem;
    color: var(--color-ink-soft);
    font-size: 1.1875rem;
    line-height: 1.5;
  }
</style>
