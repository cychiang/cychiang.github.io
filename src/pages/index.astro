---
import { getCollection } from 'astro:content';
import DeckWall from '../components/DeckWall.astro';
import PostList from '../components/PostList.astro';
import Prompt from '../components/Prompt.astro';
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

// Drafts show up while developing and are left out of the published site.
const decks = (await getCollection('decks', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const posts = (await getCollection('posts', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: Astro.site?.href,
  description: site.description,
  author: { '@type': 'Person', name: site.author.name, url: site.author.url, sameAs: site.links.map((l) => l.href) },
};
---

<Base jsonLd={jsonLd}>
  <section class="intro">
    <Prompt command="cat about.txt" />
    <h1>{site.headline}</h1>
    <p class="intro-text">{site.intro}</p>
  </section>

  <section class="decks">
    <Prompt command="ls decks/" />
    <h2 class="visually-hidden">Decks</h2>
    <DeckWall decks={decks} />
  </section>

  <section class="posts">
    <Prompt command="ls posts/" />
    <h2 class="visually-hidden">Posts</h2>
    <PostList posts={posts} />
  </section>
</Base>

<style>
  .intro {
    padding-block: clamp(2rem, 6vw, 4rem) clamp(2rem, 5vw, 3.5rem);
  }

  h1 {
    max-width: 24ch;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 4.6vw, 3.25rem);
    font-weight: var(--weight-strong);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .intro-text {
    max-width: 68ch;
    margin-top: 1.25rem;
    color: var(--color-ink-soft);
  }

  .decks :global(.prompt),
  .posts :global(.prompt) {
    margin-bottom: 1.25rem;
  }

  .posts {
    max-width: 76ch;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
</style>
