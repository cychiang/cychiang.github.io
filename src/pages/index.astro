---
import { getCollection } from 'astro:content';
import DeckWall from '../components/DeckWall.astro';
import Prompt from '../components/Prompt.astro';
import Terminal from '../components/Terminal.astro';
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

// Drafts show up while developing and are left out of the published site.
const decks = (await getCollection('decks', ({ data }) => import.meta.env.DEV || !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base>
  <section class="intro">
    <Prompt command="cat about.txt" />
    <h1>{site.headline}</h1>
    <p class="intro-text">{site.intro}</p>
  </section>

  <section class="decks">
    <h2 class="visually-hidden">Decks</h2>
    <Terminal decks={decks} />
    <DeckWall decks={decks} />
  </section>
</Base>

<style>
  .intro {
    padding-block: clamp(2rem, 6vw, 4rem) clamp(2rem, 5vw, 3.5rem);
  }

  h1 {
    max-width: 24ch;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4.6vw, 3.25rem);
    font-weight: var(--weight-strong);
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .intro-text {
    max-width: 68ch;
    margin-top: 1.25rem;
    color: var(--color-ink-soft);
  }
</style>
