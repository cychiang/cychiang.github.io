---
// The live prompt above the deck wall. Visitors can type commands that act on
// the page: list and filter decks, read about the site, open a deck. Without
// JavaScript it falls back to the static `ls decks/` line.
//
// Commands are defined in the <script> below. Keep them few, real-looking and
// useful; everything a command does must also be reachable by mouse or touch
// elsewhere on the page (the filter buttons, the deck panes, the header links).
import type { CollectionEntry } from 'astro:content';
import { site, typeLabels } from '../site.config';
import Prompt from './Prompt.astro';
import PromptPrefix from './PromptPrefix.astro';

interface Props {
  decks: CollectionEntry<'decks'>[];
}

const { decks } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');

const data = {
  base,
  name: site.name,
  about: `${site.headline} ${site.intro}`,
  links: site.links.map((link) => ({ name: link.label.toLowerCase(), href: link.href })),
  types: Object.fromEntries(Object.entries(typeLabels).map(([type, label]) => [type, label.many.toLowerCase()])),
  decks: decks.map((deck) => ({
    slug: deck.id,
    title: deck.data.title,
    description: deck.data.description,
    type: deck.data.type,
    date: deck.data.date.toISOString().slice(0, 10),
    slides: deck.data.slides,
  })),
};
---

<div class="terminal" data-terminal data-session={JSON.stringify(data)}>
  <div data-terminal-static>
    <Prompt command="ls decks/" />
  </div>

  <form class="terminal-line" data-terminal-form hidden>
    <label for="terminal-input">
      <PromptPrefix />
      <span class="visually-hidden">Terminal. Type a command and press Enter. Type help for the list.</span>
    </label>
    <input
      id="terminal-input"
      data-terminal-input
      type="text"
      placeholder="ls decks/"
      autocomplete="off"
      autocapitalize="off"
      autocorrect="off"
      spellcheck="false"
      enterkeyhint="go"
    />
    <span class="terminal-hint" aria-hidden="true">type <kbd>help</kbd></span>
  </form>

  <div class="terminal-output" data-terminal-output role="log" aria-live="polite"></div>
</div>

<script>
  interface DeckInfo {
    slug: string;
    title: string;
    description: string;
    type: string;
    date: string;
    slides: number;
  }
  interface Session {
    base: string;
    name: string;
    about: string;
    links: { name: string; href: string }[];
    types: Record<string, string>;
    decks: DeckInfo[];
  }
  /** What a command prints: plain lines, or a line that is a link. */
  type Line = string | { text: string; href: string };

  const root = document.querySelector<HTMLElement>('[data-terminal]');
  const form = root?.querySelector<HTMLFormElement>('[data-terminal-form]');
  const input = root?.querySelector<HTMLInputElement>('[data-terminal-input]');
  const output = root?.querySelector<HTMLElement>('[data-terminal-output]');

  if (root && form && input && output) {
    const session: Session = JSON.parse(root.dataset.session ?? '{}');
    const deckUrl = (slug: string) => `${session.base}/decks/${slug}/`;
    const history: string[] = [];
    let historyIndex = 0;

    const print = (lines: Line[], isError = false) => {
      output.replaceChildren(
        ...lines.map((line) => {
          const row = document.createElement('p');
          if (isError) row.className = 'is-error';
          if (typeof line === 'string') {
            row.textContent = line;
          } else {
            const link = document.createElement('a');
            link.href = line.href;
            link.textContent = line.text;
            row.append(link);
          }
          return row;
        }),
      );
    };

    /** Show only decks of one type on the wall ('all' shows everything). */
    const filterWall = (type: string) =>
      document.dispatchEvent(new CustomEvent('decks:filter', { detail: { type } }));

    /** Accepts "talk", "talks", "case-study", "case studies"… */
    const resolveType = (word: string): string | undefined => {
      const wanted = word.toLowerCase().replace(/[\s_]+/g, '-');
      if (wanted === 'all') return 'all';
      return Object.entries(session.types).find(
        ([type, plural]) => type === wanted || plural.replace(/\s+/g, '-') === wanted,
      )?.[0];
    };

    const findDeck = (word = ''): DeckInfo | undefined => {
      const slug = word.replace(/^(\.\/)?(decks\/)?/, '').replace(/\/+$/, '');
      return session.decks.find((deck) => deck.slug === slug);
    };

    const commands: Record<string, { usage: string; about: string; run: (args: string[]) => void }> = {
      help: {
        usage: 'help',
        about: 'show this list',
        run: () =>
          print([
            ...Object.values(commands).map((c) => `${c.usage.padEnd(22)}${c.about}`),
            '',
            'Tab completes a command or a deck name. Up and Down recall earlier commands.',
          ]),
      },
      ls: {
        usage: 'ls [--type <kind>]',
        about: `list decks; kinds: all, ${Object.keys(session.types).join(', ')}`,
        run: (args) => {
          const flag = args.findIndex((arg) => arg === '--type' || arg === '-t');
          const inline = args.find((arg) => arg.startsWith('--type='))?.slice(7);
          const word = inline ?? (flag >= 0 ? args[flag + 1] : undefined);
          const type = word === undefined ? 'all' : resolveType(word);
          if (!type) {
            print([`ls: unknown kind "${word}". Kinds: all, ${Object.keys(session.types).join(', ')}`], true);
            return;
          }
          const shown = session.decks.filter((deck) => type === 'all' || deck.type === type);
          filterWall(type);
          const kind = type === 'all' ? '' : ` of kind ${type}`;
          print([
            shown.length === 0
              ? `No decks${kind} yet.`
              : `${shown.length} ${shown.length === 1 ? 'deck' : 'decks'}${kind}:`,
          ]);
        },
      },
      cat: {
        usage: 'cat <name>',
        about: 'read about.txt, or a deck summary',
        run: ([name]) => {
          if (!name) return print(['cat: give a name, for example: cat about.txt'], true);
          if (name === 'about.txt' || name === 'about') return print([session.about]);
          const deck = findDeck(name);
          if (!deck) return print([`cat: ${name}: No such file or directory`], true);
          print([
            deck.title,
            deck.description,
            `${deck.date}  ${deck.type}  ${deck.slides} ${deck.slides === 1 ? 'slide' : 'slides'}`,
            { text: `open ${deck.slug}`, href: deckUrl(deck.slug) },
          ]);
        },
      },
      open: {
        usage: 'open <deck>',
        about: 'open a deck (cd works too)',
        run: ([name]) => {
          if (!name) return print(['open: give a deck name. Press Tab to see them.'], true);
          const link = session.links.find((entry) => entry.name === name.toLowerCase());
          if (link) {
            window.location.href = link.href;
            return;
          }
          const deck = findDeck(name);
          if (!deck) return print([`open: ${name}: No such deck. Try: ls`], true);
          print([`Opening ${deck.title}…`]);
          window.location.href = deckUrl(deck.slug);
        },
      },
      whoami: {
        usage: 'whoami',
        about: 'who made this, and where else to find them',
        run: () =>
          print([session.name, ...session.links.map((link) => ({ text: link.name, href: link.href }))]),
      },
      clear: {
        usage: 'clear',
        about: 'clear the output and show every deck',
        run: () => {
          filterWall('all');
          output.replaceChildren();
        },
      },
    };
    const aliases: Record<string, string> = { cd: 'open', '?': 'help', man: 'help', dir: 'ls', ll: 'ls' };

    const run = (line: string) => {
      const [name = '', ...args] = line.trim().split(/\s+/);
      const command = commands[aliases[name] ?? name];
      if (command) command.run(args);
      else print([`${name}: command not found. Type help for the list.`], true);
    };

    /** Candidates for the word being typed: commands first, then names. */
    const complete = (value: string): string[] => {
      const words = value.split(/\s+/);
      const last = words.at(-1) ?? '';
      if (words.length === 1) {
        return Object.keys(commands).filter((name) => name.startsWith(last));
      }
      const command = aliases[words[0] ?? ''] ?? words[0];
      const previous = words.at(-2);
      let pool: string[] = [];
      if (previous === '--type' || previous === '-t') pool = ['all', ...Object.keys(session.types)];
      else if (command === 'ls') pool = ['--type'];
      else if (command === 'cat') pool = ['about.txt', ...session.decks.map((deck) => deck.slug)];
      else if (command === 'open') {
        pool = [...session.decks.map((deck) => deck.slug), ...session.links.map((link) => link.name)];
      }
      return pool.filter((name) => name.startsWith(last));
    };

    const sharedPrefix = (names: string[]) =>
      names.reduce((prefix, name) => {
        let i = 0;
        while (i < prefix.length && prefix[i] === name[i]) i++;
        return prefix.slice(0, i);
      });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const line = input.value.trim() || input.placeholder;
      history.push(line);
      historyIndex = history.length;
      // The line stays visible as the placeholder, above the output it produced.
      input.placeholder = line;
      input.value = '';
      run(line);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Tab' && !event.shiftKey && input.value.trim() !== '') {
        const matches = complete(input.value);
        if (matches.length === 0) return; // nothing to complete: let Tab move focus
        event.preventDefault();
        const words = input.value.split(/\s+/);
        words[words.length - 1] = matches.length === 1 ? `${matches[0]} ` : sharedPrefix(matches);
        input.value = words.join(' ');
        if (matches.length > 1) print([matches.join('   ')]);
      } else if (event.key === 'ArrowUp' && historyIndex > 0) {
        event.preventDefault();
        input.value = history[--historyIndex] ?? '';
      } else if (event.key === 'ArrowDown' && historyIndex < history.length) {
        event.preventDefault();
        input.value = history[++historyIndex] ?? '';
      } else if (event.key === 'l' && event.ctrlKey) {
        event.preventDefault();
        commands.clear?.run([]);
      }
    });

    // Upgrade the static line to the live prompt.
    root.querySelector<HTMLElement>('[data-terminal-static]')?.remove();
    form.hidden = false;
  }
</script>

<style>
  .terminal {
    margin-bottom: 1.25rem;
  }

  .terminal-line {
    display: flex;
    align-items: baseline;
    gap: 1ch;
  }

  .terminal-line[hidden] {
    display: none;
  }

  input {
    flex: 1;
    min-width: 8ch;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: var(--color-ink);
    caret-color: var(--color-prompt);
    font: inherit;
  }

  /* The placeholder is the command whose output is on screen. */
  input::placeholder {
    color: var(--color-ink);
    opacity: 1;
  }

  input:focus::placeholder {
    color: var(--color-ink-soft);
  }

  /* The whole line shows focus, not a box around the text. */
  input:focus-visible {
    outline: none;
  }

  .terminal-line:focus-within {
    box-shadow: 0 1px 0 var(--color-accent);
  }

  .terminal-hint {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .terminal-line:focus-within .terminal-hint {
    visibility: hidden;
  }

  kbd {
    padding: 0 0.5ch;
    border: var(--border) solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-ink);
    font: inherit;
  }

  .terminal-output {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  .terminal-output:not(:empty) {
    margin-top: 0.5rem;
  }

  .terminal-output :global(p) {
    min-height: 1.65em;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .terminal-output :global(.is-error) {
    color: var(--color-flag);
  }

  /* 16px keeps iOS from zooming the page when the input is focused. */
  @media (max-width: 36rem) {
    input {
      font-size: 1rem;
    }
  }
</style>
