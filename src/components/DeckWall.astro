---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { typeLabels } from '../site.config';
import DeckCard from './DeckCard.astro';

interface Props {
  decks: CollectionEntry<'decks'>[];
}

const { decks } = Astro.props;

// Optional cover image per deck: decks/<slug>/cover.png (or .jpg / .webp).
const coverFiles = import.meta.glob<ImageMetadata>('/decks/*/cover.{png,jpg,jpeg,webp}', {
  eager: true,
  import: 'default',
});
const covers = new Map(
  Object.entries(coverFiles).map(([file, image]) => [file.split('/').at(-2), image]),
);

// Filters only earn their place once there is more than one kind of deck.
const types = [...new Set(decks.map((deck) => deck.data.type))];
const showFilters = types.length > 1;

// Until the wall has a full first row, mark where the next decks will go.
const emptySlots = Math.max(0, 3 - decks.length);
---

{
  showFilters && (
    <div class="filters" role="group" aria-label="Show decks by kind">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      {types.map((type) => (
        <button type="button" data-filter={type} aria-pressed="false">
          {typeLabels[type]?.many ?? type}
        </button>
      ))}
    </div>
  )
}

<div class="wall" data-wall>
  {decks.map((deck) => <DeckCard deck={deck} cover={covers.get(deck.id)} />)}
  {
    Array.from({ length: emptySlots }, (_, index) => (
      <div class="empty-slot" data-empty-slot>
        {index === 0 && <p>{decks.length === 0 ? 'The first deck goes here.' : 'The next deck goes here.'}</p>}
      </div>
    ))
  }
</div>

<script>
  const wall = document.querySelector<HTMLElement>('[data-wall]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button));
      for (const card of wall?.querySelectorAll<HTMLElement>('[data-type]') ?? []) {
        card.hidden = filter !== 'all' && card.dataset.type !== filter;
      }
      for (const slot of wall?.querySelectorAll<HTMLElement>('[data-empty-slot]') ?? []) {
        slot.hidden = filter !== 'all';
      }
    });
  }
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .filters button {
    padding: 0.375rem 0.875rem;
    background: transparent;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink-soft);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .filters button:hover {
    border-color: var(--color-ink-soft);
    color: var(--color-ink);
  }

  .filters button[aria-pressed='true'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: calc(var(--wall-gap) * 1.25) var(--wall-gap);
    align-items: start;
  }

  .wall :global([hidden]) {
    display: none;
  }

  /* An empty 16:9 outline, the same size as a slide. */
  .empty-slot {
    display: flex;
    align-items: flex-end;
    aspect-ratio: 16 / 9;
    padding: 1.25rem 1.375rem;
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-slide);
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
  }

  /* In a single column one outline is enough. */
  @media (max-width: 42rem) {
    .empty-slot + .empty-slot {
      display: none;
    }
  }
</style>
