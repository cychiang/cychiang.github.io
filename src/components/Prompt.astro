---
// A finished line of the "session": the prompt followed by a command that has
// already run. It labels the section below it the way a command labels its
// output. Decorative, so it is hidden from assistive technology; give the
// section a real heading or an aria-label as well.
import PromptPrefix from './PromptPrefix.astro';

interface Props {
  command: string;
}

const { command } = Astro.props;
---

<p class="prompt" aria-hidden="true">
  <PromptPrefix /><span class="prompt-command">{command}</span>
</p>

<style>
  .prompt {
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  .prompt-command {
    margin-left: 1ch;
  }
</style>
