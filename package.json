{
  "name": "cychiang.github.com",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Personal site: a wall of Slidev decks, built with Astro.",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "deck": "node scripts/deck.ts",
    "new:deck": "node scripts/new-deck.ts",
    "check": "node scripts/check-decks.ts && astro check",
    "build": "pnpm run build:site && pnpm run build:decks",
    "build:site": "astro build",
    "build:decks": "node scripts/build-decks.ts",
    "preview": "astro preview"
  },
  "slidev": {
    "addons": [
      "@/../../slidev-addon-site"
    ]
  },
  "dependencies": {
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@slidev/cli": "^53.0.0",
    "@slidev/parser": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "astro": "^7.3.0",
    "vue": "^3.5.43",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.18.0",
    "typescript": "^6.0.3"
  }
}
